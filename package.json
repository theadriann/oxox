{
  "name": "oxox-workspace",
  "version": "0.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "dev": "pnpm --filter @oxox/desktop dev",
    "dev:daemon": "pnpm --filter @oxox/daemon dev",
    "dev:web": "pnpm --parallel --filter @oxox/daemon --filter @oxox/web dev",
    "dev:web:ui": "pnpm --filter @oxox/web dev",
    "build": "pnpm --filter @oxox/desktop build",
    "build:daemon": "pnpm --filter @oxox/daemon build",
    "build:web": "pnpm --filter @oxox/web build",
    "start": "pnpm --filter @oxox/desktop start",
    "start:daemon": "pnpm --filter @oxox/daemon start",
    "start:web": "pnpm build:web && pnpm start:daemon",
    "package": "pnpm --filter @oxox/desktop package",
    "dist": "pnpm --filter @oxox/desktop dist",
    "dist:mac": "pnpm --filter @oxox/desktop dist:mac",
    "dist:mac:x64": "pnpm --filter @oxox/desktop dist:mac:x64",
    "dist:mac:arm64": "pnpm --filter @oxox/desktop dist:mac:arm64",
    "dist:mac:all": "pnpm --filter @oxox/desktop dist:mac:all",
    "release:version": "changeset version",
    "release:validate": "pnpm lint && pnpm typecheck && pnpm test",
    "release:metadata:mac": "node scripts/release/update-mac-release-metadata.mjs",
    "release:artifacts": "./package-mac-signed.sh dist:mac:all && pnpm run release:metadata:mac",
    "release:tag": "node scripts/release/create-version-tag.mjs",
    "release:github": "node scripts/release/create-github-release.mjs",
    "typecheck": "pnpm --filter @oxox/desktop typecheck",
    "test": "pnpm --filter @oxox/desktop test",
    "lint": "pnpm lint:biome && pnpm lint:ox",
    "lint:biome": "biome check .",
    "lint:ox": "oxlint . --deny-warnings",
    "check:fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/cli": "^2.30.0",
    "oxlint": "^1.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "lzma-native",
      "msw"
    ]
  }
}
